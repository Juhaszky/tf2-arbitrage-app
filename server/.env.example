# --- Elemzés ---
# Egy kulcs ára refined metalban. Csak tartalék: ha a gyűjtő már letöltötte a kulcsár history-ját,
# az elemzés azt használja (minden bejegyzést a saját korabeli kulcsárával vált át).
KEY_PRICE_METAL=65
# Eladáskor levont díj százalékban (backpack.tf cserénél 0)
SELL_FEE_PERCENT=0

# --- Gyűjtő (pricedb.io) ---
# Kikapcsolás: COLLECTOR_ENABLED=false
COLLECTOR_ENABLED=true
# Az előszűrés után vételi útvonalanként legfeljebb ennyi tárgy kap teljes (history alapú) elemzést
MAX_CANDIDATES=150
# Az előszűrés ennyi napi pillanatképen nézi, hogy az árrés tartós-e
SCREEN_SNAPSHOT_DAYS=7
# Milyen gyakran fusson a gyűjtő (cron kifejezés; alapból 30 percenként)
COLLECT_CRON=*/30 * * * *
# Egy SKU-t csak akkor kérdez le újra, ha ennyi perce nem frissült (a pricedb.io kb. 2 óránként frissít)
HISTORY_REFRESH_MINUTES=120
# Egy futásban legfeljebb ennyi SKU-t kérdez le (a többi a következő futásra marad)
MAX_SKUS_PER_RUN=200
# Szünet két kérés között ezredmásodpercben (+ legfeljebb 50% véletlen)
REQUEST_DELAY_MS=1000
# A tárgylista (/api/items) frissítési gyakorisága órában
ITEMS_REFRESH_HOURS=24
# Induláskor azonnal fusson-e egy gyűjtés
COLLECT_ON_STARTUP=true
# Hova mentse az adatokat
DATA_DIR=./data

# --- Discord értesítések ---
# A Discord csatorna webhook címe (Csatorna beállításai → Integrációk → Webhookok → Új webhook → URL másolása).
# Üresen hagyva nincs értesítés.
DISCORD_WEBHOOK_URL=

# --- mannco.store ---
# API kulcs (mannco.store fiók → beállítások). Ha megadod, az elemzés a mannco-n azonnal megvehető
# ajánlatokat is értékeli (vétel mannco-n, eladás backpack.tf-en). Üresen hagyva kimarad.
MANNCO_API_KEY=
# Futásonként legfeljebb ennyi tömeges árazó kérés a mannco buy orderekhez (kérésenként 100 tárgy, percenként 10 mehet)
MANNCO_BID_REQUESTS_PER_RUN=30
